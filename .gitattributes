# 由 Git 自动判断哪些是文本文件，入库统一为 LF
* text=auto

# 明确指定：shell 脚本必须 LF，否则 Linux 上执行报 $'\r': command not found
*.sh   text eol=lf
*.bash text eol=lf

# PowerShell 脚本用 CRLF
*.ps1  text eol=crlf

# 二进制文件禁止换行转换（否则文件会被损坏）
*.wav  binary
*.png  binary
*.jpg  binary
*.pth  binary
*.pt   binary
*.safetensors binary
*.onnx binary
